# =============================================================================
# GDUECA 官网前端 - 环境变量完整清单
#
# 使用方式：cp .env.example .env.local，按需修改后重新构建（pnpm build）
# 注意：本项目所有变量都在【构建时】固化到产物中，修改后必须重新 pnpm build，
#       仅重启 pnpm start 不会生效
# =============================================================================


# ============================ 后端地址 =======================================
# FastAPI 后端地址，仅服务端使用（不会暴露给浏览器）：
# - 浏览器请求同源 /api/*、/uploads/*，由 next.config.ts rewrites 转发到这里
# - 服务端渲染（SSR）时直接请求该地址
# 需与后端 .env 中的 HOST / PORT 一致
BACKEND_URL=http://127.0.0.1:8000

# 浏览器直连后端的地址（跨域部署）。一般【留空】，走上面的同源反代：
# 同源时登录 Cookie 为第一方 Cookie，无需配置 CORS。
# 仅当后端部署在独立域名且不经前端转发时设置，同时后端 CORS_ORIGINS 必须写明前端来源
NEXT_PUBLIC_API_BASE_URL=
# 示例：NEXT_PUBLIC_API_BASE_URL=https://api.paperee.guru

# dev 服务器跨源白名单追加项（仅 development 生效，逗号分隔，一般【留空】）：
# 通过局域网 IP / Tailscale IP / 域名访问 dev server 时，Next 16 要求来源在
# allowedDevOrigins 内，否则客户端运行时被阻塞（页面停留在 SSR 初始态）。
# next.config.ts 已内置 127.0.0.1 / 本机局域网与 Tailscale 网卡 IP / *.paperee.guru；
# 网卡 IP 变动或新增访问域名时在此追加，无需改代码（改后需重启 dev server）
DEV_ALLOWED_ORIGINS=
# 示例：DEV_ALLOWED_ORIGINS=192.168.1.100,my-host.local


# ============================== 站点信息 =====================================
# 站点对外访问地址（无末尾斜杠），用于 sitemap.xml / robots.txt 中的绝对链接
NEXT_PUBLIC_SITE_URL=https://gdue-ca.paperee.guru


# ========================= Umami 网站统计（可选） ===============================
# 两项都填写才会加载统计脚本；统计脚本来源会自动加入 CSP 白名单
# 网站 ID：Umami 后台「设置 → 网站」中获取
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# 统计脚本完整地址
NEXT_PUBLIC_UMAMI_SRC=
# 示例：NEXT_PUBLIC_UMAMI_SRC=https://umami.example.com/script.js
