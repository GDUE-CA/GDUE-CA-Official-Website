# =============================================================================
# GDUECA 官网前端 - 环境变量完整清单
#
# 使用方式：cp .env.example .env.local，按需修改后重新构建（pnpm build）
# 注意：本项目所有变量都在【构建时】固化到产物中，修改后必须重新 pnpm build，
#       仅重启 pnpm start 不会生效
# =============================================================================


# ============================ 后端地址 =======================================
# FastAPI 后端地址，仅服务端使用（不会暴露给浏览器）：
# - 浏览器请求同源 /api/*、/uploads/*，由 next.config.ts rewrites 转发到这里
# - 服务端渲染（SSR）时直接请求该地址
# 需与后端 .env 中的 HOST / PORT 一致
BACKEND_URL=http://127.0.0.1:8000

# 浏览器直连后端的地址（跨域部署）。一般【留空】，走上面的同源反代：
# 同源时登录 Cookie 为第一方 Cookie，无需配置 CORS。
# 仅当后端部署在独立域名且不经前端转发时设置，同时后端 CORS_ORIGINS 必须写明前端来源
NEXT_PUBLIC_API_BASE_URL=
# 示例：NEXT_PUBLIC_API_BASE_URL=https://api.paperee.guru

# dev 服务器跨源白名单追加项（仅 development 生效，逗号分隔，一般【留空】）：
# 通过局域网 IP / Tailscale IP / 域名访问 dev server 时，Next 16 要求来源在
# allowedDevOrigins 内，否则客户端运行时被阻塞（页面停留在 SSR 初始态）。
# next.config.ts 已内置 127.0.0.1 / 本机局域网与 Tailscale 网卡 IP / *.paperee.guru；
# 网卡 IP 变动或新增访问域名时在此追加，无需改代码（改后需重启 dev server）
DEV_ALLOWED_ORIGINS=
# 示例：DEV_ALLOWED_ORIGINS=192.168.1.100,my-host.local


# ============================== 站点信息 =====================================
# 站点对外访问地址（无末尾斜杠），用于 sitemap.xml / robots.txt 中的绝对链接
NEXT_PUBLIC_SITE_URL=https://gdue-ca.paperee.guru


# ========================= Umami 网站统计（可选） ===============================
# 两项都填写才会加载统计脚本；统计脚本来源会自动加入 CSP 白名单
# 网站 ID：Umami 后台「设置 → 网站」中获取
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# 统计脚本完整地址
NEXT_PUBLIC_UMAMI_SRC=
# 示例：NEXT_PUBLIC_UMAMI_SRC=https://umami.example.com/script.js


# ========================= 访问风控 / 人机验证（可选） ==========================
# 每个页面请求按访客 IP 查询外部风控接口（结果缓存），根据 isRisky / isIdc / isProxy：
#   - 三项均为 false            → 正常访问
#   - isIdc 与 isProxy 同时为 true → 直接 403 拒绝页（展示下方联系方式，提示关闭代理或申请白名单）
#   - 其余任一为 true            → Cloudflare Turnstile 人机验证，通过后在有效期内免检
# 内网 IP、白名单 IP、经 DNS 反查校验的搜索引擎爬虫（Google / Bing / 百度 / Yandex / 搜狗 /
# Apple / Petal）不受影响；风控接口超时、限流或故障时一律放行，不影响正常访问。
# 依赖 Nginx 用真实对端覆盖 X-Real-IP / X-Forwarded-For，Next.js 不可直接暴露在公网。
# 以下变量在【运行时】读取，修改后重启前端即可，无需重新构建。

# 总开关（true 启用）
RISK_GUARD_ENABLED=false
# 风控接口，{ip} 替换为访客 IP
RISK_API_URL=https://risk.catyuki.com/api/v1/ip/{ip}
# 风控接口超时（毫秒），超时放行
RISK_API_TIMEOUT_MS=1500
# 同一 IP 风控结果缓存时长（秒）；接口有频率限制，不宜过短
RISK_CACHE_TTL_SECONDS=1800
# 管理员白名单：逗号分隔的 IP 或 CIDR，命中则跳过所有检查
# 示例：RISK_IP_ALLOWLIST=203.0.113.7,198.51.100.0/24,2001:db8::/48
RISK_IP_ALLOWLIST=

# Cloudflare Turnstile（https://dash.cloudflare.com → Turnstile 创建站点获取）
# 两项都配置才会下发人机验证；未配置时风险 IP（403 一档除外）直接放行
# 本地测试可用官方测试密钥（始终通过）：
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 通过验证后免检时长（小时），凭证绑定访客 IP（IPv6 绑定 /64）
RISK_PASS_TTL_HOURS=12
# 通行凭证签名密钥（建议 openssl rand -hex 32 生成）；留空则由 TURNSTILE_SECRET_KEY 派生
RISK_PASS_SECRET=

# 403 拒绝页展示的管理员联系方式（邮箱会生成带诊断信息的 mailto 按钮）
RISK_CONTACT_EMAIL=
# 可选：其他联系方式页面（须 http(s):// 开头，如外部表单 / 群聊邀请链接）
RISK_CONTACT_URL=
