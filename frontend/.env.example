# =============================================================================
# GDUECA 官网前端 - 环境变量完整清单
#
# 使用方式：cp .env.example .env.local，按需修改后重新构建（pnpm build）
# 注意：本项目所有变量都在【构建时】固化到产物中，修改后必须重新 pnpm build，
#       仅重启 pnpm start 不会生效
# =============================================================================


# ============================ 后端地址 =======================================
# FastAPI 后端地址，仅服务端使用（不会暴露给浏览器）：
# - 浏览器请求同源 /api/*、/uploads/*，由 next.config.ts rewrites 转发到这里
# - 服务端渲染（SSR）时直接请求该地址
# 需与后端 .env 中的 HOST / PORT 一致
BACKEND_URL=http://127.0.0.1:8000

# 浏览器直连后端的地址（跨域部署）。一般【留空】，走上面的同源反代：
# 同源时登录 Cookie 为第一方 Cookie，无需配置 CORS。
# 仅当后端部署在独立域名且不经前端转发时设置，同时后端 CORS_ORIGINS 必须写明前端来源
NEXT_PUBLIC_API_BASE_URL=
# 示例：NEXT_PUBLIC_API_BASE_URL=https://api.gdueca.com

# dev 服务器跨源白名单追加项（仅 development 生效，逗号分隔，一般【留空】）：
# 通过局域网 IP / Tailscale IP / 域名访问 dev server 时，Next 16 要求来源在
# allowedDevOrigins 内，否则客户端运行时被阻塞（页面停留在 SSR 初始态）。
# next.config.ts 已内置 127.0.0.1 / 本机局域网与 Tailscale 网卡 IP / *.gdueca.com；
# 网卡 IP 变动或新增访问域名时在此追加，无需改代码（改后需重启 dev server）
DEV_ALLOWED_ORIGINS=
# 示例：DEV_ALLOWED_ORIGINS=192.168.1.100,my-host.local


# ============================== 站点信息 =====================================
# 站点对外访问地址（无末尾斜杠），用于 sitemap.xml / robots.txt / canonical / hreflang 的绝对链接
# SITE_URL 运行时读取（systemd 部署改完重启即生效）；NEXT_PUBLIC_SITE_URL 构建时固化（Docker 构建参数）
# 两者都不填时按请求域名推断
SITE_URL=
NEXT_PUBLIC_SITE_URL=https://www.gdueca.com


# ========================= Umami 网站统计（可选） ===============================
# 两项都填写才会加载统计脚本；统计脚本来源会自动加入 CSP 白名单
# 网站 ID：Umami 后台「设置 → 网站」中获取
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# 统计脚本完整地址
NEXT_PUBLIC_UMAMI_SRC=
# 示例：NEXT_PUBLIC_UMAMI_SRC=https://umami.example.com/script.js


# ========================= 访问风控 / 人机验证（可选） ==========================
# 启用后，未持有通行凭证的访客首次打开页面会先看到「正在检查访问环境」检测页：
# 由访客浏览器带上本站下发的 aud / nonce 直接请求风控接口 v2（接口按来源 IP 自行判定，并对结果做
# Ed25519 签名），再把签名令牌原样交回本站服务端验签（公钥取自 RISK_KEYS_URL），根据 isRisky / isIdc / isProxy：
#   - 三项均为 false 且令牌有效    → 直接进入页面，无需任何操作
#   - isIdc 与 isProxy 同时为 true → 拒绝访问页（展示下方联系方式，提示关闭代理或申请白名单）
#   - 其余任一为 true              → Cloudflare Turnstile 验证码（未配置 Turnstile 时改为工作量证明 PoW）
#   - 接口故障 / 超时 / 令牌无效（验签失败、过期、aud / nonce / IP 不一致）→ 同上，一律要求验证
# 通过后签发绑定 IP 的通行 Cookie，有效期内不再检测。
# 内网 IP、白名单 IP、经 DNS 反查校验的搜索引擎爬虫（Google / Bing / 百度 / Yandex / 搜狗 /
# Apple / Petal）、链接预览机器人（见下方 RISK_ALLOW_PREVIEW_BOTS）不经过检测页。
# 注意：
#   - 风控接口须已配置签名密钥（riskAPI 的 RISK_SIGNING_KEY），否则不签发令牌，所有访客都会进入验证码
#   - 浏览器访问风控接口与访问本站走不同出口（如一边 IPv6、一边 IPv4）时 IP 对不上，会进入验证码
#   - 依赖 Nginx 用真实对端覆盖 X-Real-IP / X-Forwarded-For，Next.js 不可直接暴露在公网
# 以下变量在【运行时】读取，修改后重启前端即可，无需重新构建。

# 总开关（true 启用）
RISK_GUARD_ENABLED=false
# 风控接口 v2（浏览器直接请求，会自动加入检测页 CSP connect-src）
RISK_API_URL=https://risk.catyuki.com/api/v2/ip
# 验签公钥集（JWK Set），默认取风控接口同源的 /.well-known/risk-keys.json；缓存 5 分钟，遇到新 kid 自动刷新
RISK_KEYS_URL=
# 本站可接受的令牌 aud（逗号分隔的主机名），须与访客浏览器地址栏中的主机名一致；
# 默认取 NEXT_PUBLIC_SITE_URL 的主机名。多域名访问时全部列出；
# 风控接口若配置了 RISK_TOKEN_AUDIENCES 白名单，也要包含这些主机名
RISK_TOKEN_AUD=
# 浏览器请求风控接口的超时（毫秒），超时按检测失败处理（要求验证）
RISK_API_TIMEOUT_MS=4000
# 工作量证明总难度（8~24，每 +1 计算量翻倍）；仅在未配置 Turnstile 时作为人机验证使用
# 20 约为桌面 0.5 秒、手机 2~5 秒（浏览器纯 JS 约 2M 次哈希/秒）。
# 注意：bot 用原生代码 / GPU 求解快几个数量级，单靠加难度只会拖慢真人，拦截靠下面的最短耗时
RISK_POW_DIFFICULTY=20
# 总计算量拆成的子题数（1~16）：计算量不变，耗时更稳定，避免偶发数倍于平均值的长尾
RISK_POW_PUZZLES=4
# 题目签发后至少多少秒才接受提交（0~30）：与算力无关，每次通过都至少耗时这么久
RISK_POW_MIN_SECONDS=3
# 管理员白名单：逗号分隔的 IP 或 CIDR，命中则跳过检测
# 示例：RISK_IP_ALLOWLIST=203.0.113.7,198.51.100.0/24,2001:db8::/48
RISK_IP_ALLOWLIST=

# 放行社交平台 / IM 的链接预览机器人（Facebook / X / LinkedIn / Slack / Discord / Telegram /
# WhatsApp / Pinterest / Reddit / Mastodon / Bluesky 等），保证分享卡片正常显示。
# 这类机器人无法验证真伪、只能按 UA 识别，可被伪造：仅放行 GET/HEAD，且每个 IP 每 10 分钟
# 最多放行 20 次，超出照常检测。设为 false 关闭
RISK_ALLOW_PREVIEW_BOTS=true
# 追加预览机器人 UA 关键字（逗号分隔，不区分大小写的子串匹配），如国内 IM 的预览抓取器
# 注意不要填会出现在普通用户浏览器里的关键字（如 MicroMessenger 是微信内置浏览器，填了等于对微信用户关闭检测）
RISK_PREVIEW_BOT_UA=

# Cloudflare Turnstile（https://dash.cloudflare.com → Turnstile 创建站点获取）
# 两项都配置才使用验证码（此时不再接受工作量证明）；未配置时风险访客改用工作量证明
# 本地测试可用官方测试密钥（始终通过）：
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 通过检测后免检时长（小时），凭证绑定访客 IP（IPv6 绑定 /64）
RISK_PASS_TTL_HOURS=12
# 通行凭证 / nonce / PoW 题目签名密钥（建议 openssl rand -hex 32 生成）；
# 留空则由 TURNSTILE_SECRET_KEY 派生，两者都没有时使用进程内随机密钥（重启后需重新检测，多实例不可用）
RISK_PASS_SECRET=

# 拒绝访问页展示的管理员联系方式（邮箱会生成带诊断信息的 mailto 按钮）
RISK_CONTACT_EMAIL=
# 可选：其他联系方式页面（须 http(s):// 开头，如外部表单 / 群聊邀请链接）
RISK_CONTACT_URL=
