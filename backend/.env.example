# =============================================================================
# GDUECA 官网后端 - 环境变量完整清单
#
# 使用方式：cp .env.example .env，按需修改后重启后端（python run.py）
# 所有变量均可留空 / 删除，此时使用右侧注释中的默认值
# 标注【生产必改】的项目在上线前必须按实际环境配置
# =============================================================================


# ============================ 服务监听 =======================================
# 监听地址：127.0.0.1 = 仅本机（推荐，浏览器经前端同源 /api 或 Nginx 反代访问）
#           ::        = IPv4 + IPv6 双栈（需要其他机器直连后端时才使用）
HOST=127.0.0.1
# 监听端口；修改后前端 BACKEND_URL 与 Nginx/Caddy 配置需同步修改
PORT=8000


# ============================== 数据库 =======================================
# 默认 SQLite（文件位于 backend/assoc.db，无需额外配置）
DATABASE_URL=sqlite+aiosqlite:///./assoc.db
# 切换 PostgreSQL（需安装 asyncpg，备份脚本需本机有 pg_dump）：
# DATABASE_URL=postgresql+asyncpg://gdueca:强密码@127.0.0.1:5432/gdueca


# ============================ JWT 登录令牌 ====================================
# 【生产必改】签名密钥，>= 32 位随机字符串，泄露后可伪造任意登录态
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
# 留空或使用示例值时，后端自动生成随机密钥并保存到 backend/.jwt_secret（权限 0600）
JWT_SECRET_KEY=
# 签名算法（一般无需修改）
JWT_ALGORITHM=HS256
# 未勾选「记住此设备」时的登录有效期上限（小时）；另有 30 分钟空闲超时
JWT_EXPIRE_HOURS=24


# ============================ 登录 Cookie =====================================
# 会话 Cookie 的 Secure 标记：
#   auto  = HTTPS 访问时自动加 Secure（默认，兼容本地 / 局域网 HTTP 调试）
#   true  = 始终加 Secure【生产全站 HTTPS 后建议】
#   false = 从不加（仅限纯 HTTP 内网环境）
COOKIE_SECURE=auto


# ============================ 跨域 / 域名 =====================================
# 仅在前端跨域直连后端（前端配置了 NEXT_PUBLIC_API_BASE_URL）时需要：
# 写明前端完整来源，逗号分隔，禁止使用 *（登录态为 Cookie，必须精确匹配）
# 推荐前端同源 /api 反代（默认方式），此时留空即可
CORS_ORIGINS=
# 示例：CORS_ORIGINS=https://gdue-ca.paperee.guru

# 允许访问后端的 Host 白名单，逗号分隔；留空不校验
# 也可在后台「系统设置」中配置（数据库配置优先生效）
ALLOWED_HOSTS=


# ==================== 网络访问控制（管理员来源 IP 白名单） ======================
# 管理员级账号（editor / admin / super_admin 及 Break-Glass 应急账号）的可信来源 IP，
# 逗号分隔，支持 IPv4 / IPv6 地址及两者的 CIDR 网段（可混合存放），例如：
# ADMIN_TRUSTED_IPS=127.0.0.1,192.168.1.0/24,::1,2001:db8::/32
# 默认留空 = 关闭白名单：接受全部来源 IP，账号密码正确即可登录（防爆破、指纹限流照常生效）
# 填入一个或多个条目后开启白名单模式：仅列表内来源可登录 / 使用管理员账号，
# 其余来源直接拒绝（提示「请求来源不合法」）；普通用户（member）不受此变量影响。
# 优先级：后台 Web 配置（管理员可信 IP 白名单）优先生效；数据库配置为空时才读取本环境变量。
ADMIN_TRUSTED_IPS=

# 可信反向代理地址，逗号分隔 CIDR：只有来自这些地址的 X-Forwarded-For 才会被采信
# 前端 Next.js / Nginx / Caddy 与后端同机部署时保持默认；
# 反代在其他机器（如 Docker 网桥 172.17.0.1）时追加其地址，切勿配置为 0.0.0.0/0
TRUSTED_PROXIES=127.0.0.1/32,::1/128


# 登录失败处理：已由（账号+维度）阶梯防爆破替代（app/core/brute_force.py，数据存 KV/Redis），
# 无需任何配置项


# ==================== Break-Glass 应急账号（最高权限） ==========================
# 默认凭据 admin / admin；首次登录后系统强制进入初始化向导并改密。
# 生产部署强烈建议覆盖为独立强密码：python scripts/generate_super_admin.py
# 脚本会输出可直接粘贴的 env 片段；明文密码只显示一次，请立即存入密码管理器。
# 留空则自动使用默认 admin/admin；显式设置则以 env 为准。
# 详见 docs/BREAK_GLASS_OPS.md
SUPER_ADMIN_USERNAME=admin
# bcrypt 哈希（$2a$/$2b$/$2y$ 开头 60 字符）；禁止存放明文
SUPER_ADMIN_PASSWORD_HASH=$2b$12$N.xxjoNZt4mi2Trf4Bmq1e0l46NFNTf9.6CBFZGueUZhlWfFAvnYC
# 仅允许 true / false；false 时禁止应急账号登录
SUPER_ADMIN_ENABLED=true


# ==================== 通用 KV 存储（防爆破/封禁/应急会话） ======================
# Redis 连接串，如 redis://127.0.0.1:6379/0；生产环境必须配置（多 worker 共享计数）。
# 留空时使用进程内存兜底（仅适合单进程开发，重启即丢失，启动时会输出警告日志）
REDIS_URL=


# ============================ 内容翻译（DeepL） =================================
# 公告 / 活动 / 博客 / 项目等 CMS 内容只维护中、英两个版本：中文原文译英文，英文原文译中文；
# 中文界面（zh-*）看中文版，其他语言界面看英文版。译文存入 translation_cache 表，
# 公告在后台保存时即预翻译入库。留空则不翻译（一律展示原文）。
# Free 版 key 以 ":fx" 结尾，自动走 api-free.deepl.com（额度见 DeepL 账户页）
DEEPL_API_KEY=
# 自定义接口地址，一般留空（按 key 类型自动选择）
DEEPL_API_URL=

# ================================ 日志 =======================================
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志格式：
#   text = 单行文本（默认），如：
#          2026-09-30T14:05:01.123+08:00 INFO  [trace=9f2c…] gdueca.access | GET /api/activities 200 3.2ms ip=10.0.0.8
#   json = 一行一个 JSON（接入 Loki / ELK 等日志系统时使用）
# 每条日志都带 traceId；响应头 X-Trace-Id 回传同一值，审计日志 audit_logs.trace_id 也会记录
LOG_FORMAT=text


# ============================== 接口文档 =====================================
# 是否开放 /docs、/redoc、/openapi.json；生产环境保持 false 以减少暴露面
ENABLE_API_DOCS=false
